{
  "expo": {
    "name": "Allstars",
    "slug": "wombourne-allstars",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wombourneallstars",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0c0f",
    "ios": {
      "bundleIdentifier": "uk.co.wombourneallstars.app",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/icon.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uk.co.wombourneallstars.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0c0f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0c0f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#C8102E",
          "defaultChannel": "club"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "cf906d6d-7c56-4393-a44e-69a30777d0fb"
      }
    },
    "owner": "jonbunce",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cf906d6d-7c56-4393-a44e-69a30777d0fb"
    }
  }
}
